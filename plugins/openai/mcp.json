{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "recallsnearme": {
      "type": "streamable-http",
      "url": "https://recallsnearme.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "account:read",
              "vin:read",
              "vin:run",
              "audits:read",
              "audits:manage",
              "events:read",
              "monitoring:manage"
            ]
          }
        }
      }
    }
  }
}
